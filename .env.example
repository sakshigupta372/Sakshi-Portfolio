# Copy to .env.local for local development (.env.local is git-ignored).
# On Vercel, add these under Project → Settings → Environment Variables.
# None of these are exposed to the browser.

# --- "Ask my agent" chat (Gemini) ---------------------------------------
# Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (Google's alias for the current Flash model).
GEMINI_MODEL=

# --- Contact form (Resend) ---------------------------------------------
# Key from https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered. Defaults to sg6227174@gmail.com.
CONTACT_TO_EMAIL=
# Sender. Without a verified domain, keep the default onboarding@resend.dev
# (Resend then only delivers to the email you signed up with).
CONTACT_FROM_EMAIL=
